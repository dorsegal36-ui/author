---
import BaseLayout from './BaseLayout.astro';
import { isRtl, languageLabels, type Story } from '@/lib/stories';
import { formatWrittenYear } from '@/lib/storyDates.mjs';

interface Props {
  story: Story;
}

const { story } = Astro.props;
const direction = isRtl(story.data.language) ? 'rtl' : 'ltr';
const published = story.data.publishedAt.toLocaleDateString('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const writtenYear = formatWrittenYear(story.data.writtenAt);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={story.data.title} description={`Read ${story.data.title}.`}>
  <article class="story-page" dir={direction}>
    <a class="back-link" href={`${basePath}/library`}>Back to library</a>
    <header class="story-heading">
      <p class="eyebrow">{languageLabels[story.data.language]} | {published}</p>
      <h1>{story.data.title}</h1>
      <p class="story-year">{writtenYear}</p>
    </header>
    <div class="story-body">
      <slot />
    </div>
  </article>
  <section class="comments-wrap">
    <slot name="comments" />
  </section>
</BaseLayout>
