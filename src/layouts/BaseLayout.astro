---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A multilingual archive of short stories.' } = Astro.props;
const pageTitle = title === 'Stories' ? title : `${title} | Stories`;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline define:vars={{ basePath }}>
      const adminAuthTokens = [
        'invite_token=',
        'confirmation_token=',
        'recovery_token=',
        'access_token='
      ];

      if (
        window.location.hash &&
        adminAuthTokens.some((token) => window.location.hash.includes(token))
      ) {
        window.location.replace(`${basePath}/admin/index.html${window.location.hash}`);
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${basePath}/`}>Stories</a>
      <nav aria-label="Primary navigation">
        <a href={`${basePath}/library`}>Library</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
