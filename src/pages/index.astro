---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedStories, getStoryAuthor, getStorySlug, languageLabels, storiesByLanguage } from '@/lib/stories';
import { formatWrittenYear } from '@/lib/storyDates.mjs';

const stories = await getPublishedStories();
const groups = storiesByLanguage(stories);
const recent = stories.slice(0, 5);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Stories">
  <section class="hero">
    <h1>A quiet place for short stories.</h1>
    <p class="lede">
      A multilingual archive of fiction and fragments, organized for reading rather than scrolling.
    </p>

    <div class="language-grid" aria-label="Story languages">
      {
        groups.map((group) => (
          <a class="language-card" href={`${basePath}/library#${group.language}`}>
            <strong>{group.label}</strong>
            <span>
              {group.stories.length} {group.stories.length === 1 ? 'story' : 'stories'}
            </span>
          </a>
        ))
      }
    </div>

    <h2 class="section-title">Recent stories</h2>
    <div class="story-list">
      {
        recent.map((story) => (
          <a
            class="story-card"
            href={`${basePath}/stories/${getStorySlug(story)}`}
            dir={story.data.language === 'hebrew' ? 'rtl' : 'ltr'}
          >
            <strong>{story.data.title}</strong>
            <span>{getStoryAuthor(story)} | {languageLabels[story.data.language]} | {formatWrittenYear(story.data.writtenAt)}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
