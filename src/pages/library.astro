---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedStories, getStoryAuthor, getStorySlug, languageLabels, storiesByLanguage } from '@/lib/stories';
import { formatWrittenYear } from '@/lib/storyDates.mjs';

const stories = await getPublishedStories();
const groups = storiesByLanguage(stories);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Library">
  <section class="library">
    <h1>Library</h1>
    <p class="lede">Browse the archive by language.</p>

    <nav class="filters" aria-label="Language filters">
      {groups.map((group) => <a href={`#${group.language}`}>{group.label}</a>)}
    </nav>

    {
      groups.map((group) => (
        <section id={group.language}>
          <h2 class="section-title">{group.label}</h2>
          <div class="story-list">
            {group.stories.map((story) => (
              <a
                class="story-card"
                href={`${basePath}/stories/${getStorySlug(story)}`}
                dir={story.data.language === 'hebrew' ? 'rtl' : 'ltr'}
              >
                <strong>{story.data.title}</strong>
                <span>{getStoryAuthor(story)} | {languageLabels[story.data.language]} | {formatWrittenYear(story.data.writtenAt)}</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </section>
</BaseLayout>
